# Порт приложения
APP_PORT=8080
# OpenAI-совместимый LLM (необязательно: без ключа работает упрощённый режим).
# Ключ для жюри — в secrets.env.age. Провайдер AITunnel: LLM_BASE_URL=https://api.aitunnel.ru/v1/, LLM_MODEL=qwen3.7-flash
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Запасной LLM-провайдер (необязательно): включается сам, если основной не отвечает
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# Пароль единой базы PostgreSQL (сервис db в docker-compose; наружу не открыта). По умолчанию okno
DB_PASSWORD=
